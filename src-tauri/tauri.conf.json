{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Televizion",
  "version": "1.2.0",
  "identifier": "tv.televizion.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEQjc0NUNDMjA2QjE4QTIKUldTaUdHc2d6RVczellvRktXa2JSYUorNXhxNXpTcGMwd21TekphQTBwZUNXemdlN1VlV040amEK",
      "endpoints": [
        "https://github.com/mindkind1337/televizion-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
